# URL of your backend/serverless endpoint that calls the AI provider.
# Never put an AI provider API key directly in frontend code or in a
# VITE_* variable — VITE_* variables are bundled into the client build
# and are publicly visible. Keep the real API key on your backend only.
VITE_AI_API_URL=

# PostHog public API key for analytics (safe for client-side use)
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=https://us.posthog.com
